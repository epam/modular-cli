{
  "version": {
    "type": "root command",
    "description": "Describes available module(s) version",
    "body": {
      "parameters": [
        {
          "name": "module",
          "description": "Describes specified module version"
        },
        {
          "name": "detailed",
          "description": "Describes all module(s) version"
        }
      ]
    }
  },
  "login": {
    "type": "root command",
    "description": "Returns JWT token and commands meta in accordance with the user's permissions",
    "body": {
      "parameters": {
      }
    }
  },
  "health_check": {
    "type": "root command",
    "description": "Returns service health status",
    "body": {
      "parameters": {
      }
    }
  },
  "setup": {
    "type": "root command",
    "description": "Configures Modular-CLI",
    "body": {
      "parameters": [
        {
          "name": "username",
          "description": "User name associated with the Maestro user"
        },
        {
          "name": "password",
          "description": "Password associated with the Maestro user"
        },
        {
          "name": "api_path",
          "description": "Address of the Maestro environment"
        }
      ]
    }
  },
  "cleanup": {
    "type": "root command",
    "description": "Removes all the configuration data related to the tool",
    "body": {
      "parameters": {
      }
    }
  },
  "enable_autocomplete": {
    "type": "root command",
    "description": "Enables command auto-completion suggestions",
    "body": {
      "parameters": []
    }
  },
  "disable_autocomplete": {
    "type": "root command",
    "description": "Disables command auto-completion",
    "body": {
      "parameters": []
    }
  },
  "set_output": {
    "type": "root command",
    "description": "Set default output format for all commands",
    "body": {
      "parameters": [
        {
          "name": "format",
          "description": "Output format CLI|TABLE|JSON"
        }
      ]
    }
  },
  "get_output": {
    "type": "root command",
    "description": "Show current default output format setting",
    "body": {
      "parameters": []
    }
  }
}